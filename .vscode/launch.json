{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Electron (processo main)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": [".", "--dev"],
      "preLaunchTask": "vite",
      "outputCapture": "std"
    }
  ]
}
