{
  "name": "wbs-manager",
  "productName": "WBS Manager",
  "version": "1.0.0",
  "description": "Gestione grafica di una WBS con task collegati da frecce",
  "author": "Alessandro Puglisi",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "vite": "vite --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "vite --host 0.0.0.0 --port 3000",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "dist:setup": "npm run build && electron-builder --win nsis --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --config.directories.output=release-portable",
    "dist:all": "node -e \"const fs=require('node:fs'); for (const dir of ['release/win-unpacked','release-portable/win-unpacked']) fs.rmSync(dir,{recursive:true,force:true})\" && npm run build && electron-builder --win nsis --x64 && electron-builder --win portable --x64 --config.directories.output=release-portable"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.11.0",
    "date-fns": "^4.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "zustand": "^5.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13"
  }
}
